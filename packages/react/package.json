{
  "name": "@electron-media/react",
  "version": "0.1.9",
  "description": "React binding for @electron-media/core — a single useMediaPlayer hook exposing audio/subtitle track selection and playback state.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/@electron-media/react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuraZakaryan/electron-media.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/YuraZakaryan/electron-media/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electron-media/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
