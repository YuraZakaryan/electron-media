{
  "name": "media-player-core-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "pretest:e2e": "node e2e/generate-stream.mjs && pnpm -r build && node e2e/build-react-harness.mjs",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "prerelease:build": "pnpm -r build",
    "release": "changeset version && pnpm prerelease:build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.9"
}
